#include <windows.h>

#define IDI_APP_ICON 1

IDI_APP_ICON ICON "../../assets/branding/wid-logo.ico"
1 RT_MANIFEST "WallpaperIdentity.manifest"

1 VERSIONINFO
 FILEVERSION 4,0,1,0
 PRODUCTVERSION 4,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Wallpaper Identity\0"
      VALUE "FileDescription", "Wallpaper Identity setup and pre-login service\0"
      VALUE "FileVersion", "4.0.1\0"
      VALUE "InternalName", "WallpaperIdentity\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 Austin McChord\0"
      VALUE "OriginalFilename", "WallpaperIdentitySetup.exe\0"
      VALUE "ProductName", "Wallpaper Identity (W:ID)\0"
      VALUE "ProductVersion", "4.0.1\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
